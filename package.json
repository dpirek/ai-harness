{
  "name": "ai-coding-harness",
  "version": "1.0.0",
  "description": "A desktop coding agent harness using Electron and the OpenAI Responses API",
  "main": "electron/main.js",
  "bin": {
    "ai-harness": "./index.js"
  },
  "scripts": {
    "start": "electron .",
    "cli": "node index.js",
    "web": "node server.js",
    "dev": "electron .",
    "dev:web": "nodemon server.js",
    "build": "electron-builder",
    "dist": "electron-builder --publish never",
    "test": "node --test"
  },
  "keywords": [
    "ai",
    "coding-agent",
    "openai",
    "cli"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "build": {
    "appId": "com.aiharness.desktop",
    "productName": "AI Harness",
    "asar": true,
    "files": [
      "electron/**",
      "lib/**",
      "public/**",
      "server.js",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "public/logo.png",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "public/logo.png",
      "target": "nsis"
    },
    "linux": {
      "category": "Development",
      "icon": "public/logo.png",
      "target": [
        "AppImage",
        "deb"
      ]
    }
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  }
}
